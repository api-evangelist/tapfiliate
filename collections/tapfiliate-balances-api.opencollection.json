{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tapfiliate REST Affiliate Groups Balances API",
    "version": "1.6"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Balances",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all balances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tapfiliate.com/1.6/balances/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Retrieve all affiliate balances across programs."
        }
      ]
    }
  ],
  "bundled": true
}